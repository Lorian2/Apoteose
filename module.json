{
  "id": "constelacao-da-apoteose",
  "type": "module",
  "title": "Constelação da Apoteose",
  "description": "Sistema de evolução narrativa para Foundry VTT: cada personagem constrói sua própria constelação de Aspectos, revelada e controlada inteiramente pelo Mestre.",
  "version": "0.2.0",
  "compatibility": {
    "minimum": 13,
    "verified": 14
  },
  "authors": [
    {
      "name": "Luan"
    }
  ],
  "esmodules": [
    "dist/main.js"
  ],
  "styles": [
    "styles/constelacao.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "url": "https://github.com/Lorian2/Apoteose",
  "manifest": "https://github.com/Lorian2/Apoteose/releases/latest/download/module.json",
  "download": "https://github.com/Lorian2/Apoteose/releases/download/v0.2.0/constelacao-da-apoteose.zip",
  "readme": "https://github.com/Lorian2/Apoteose/blob/main/README.md",
  "changelog": "https://github.com/Lorian2/Apoteose/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/Lorian2/Apoteose/issues"
}
