<div class="constelacao-panel-inner">
{{#if selectedNode}}
  <form data-panel-form data-node-id="{{selectedNode.id}}" autocomplete="off">
    <header class="constelacao-panel-header">
      <p class="constelacao-section-title">{{selectedNode.name}}</p>
      <div class="constelacao-panel-header-actions">
        <button type="button" data-action="focusNode" data-tooltip="Centralizar no canvas"><i class="fa-solid fa-crosshairs"></i></button>
        {{#unless selectedNode.isInitial}}
        <button type="button" data-action="removeSelected" data-tooltip="Remover Aspecto (Del)"><i class="fa-solid fa-trash"></i></button>
        {{/unless}}
        <button type="button" data-action="clearSelection" data-tooltip="Fechar (Esc)"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </header>

    <p class="constelacao-status constelacao-status--{{selectedNode.status}}">{{selectedNode.statusLabel}}</p>

    <label class="constelacao-toggle-row">
      <input type="checkbox" name="visibility-toggle" {{checked selectedNode.revealed}}>
      Revelado ao jogador
    </label>
    <label class="constelacao-toggle-row{{#if selectedNode.unlockDisabled}} disabled{{/if}}">
      <input type="checkbox" name="unlocked-toggle" {{checked selectedNode.unlocked}} {{disabled selectedNode.unlockDisabled}}>
      Desbloqueado <span class="constelacao-hint">{{selectedNode.unlockHint}}</span>
    </label>

    <label>Nome
      <input type="text" name="name" value="{{selectedNode.name}}">
    </label>
    <label>Subtítulo
      <input type="text" name="subtitle" value="{{selectedNode.subtitle}}">
    </label>
    <label>Citação
      <input type="text" name="quote" value="{{selectedNode.quote}}">
    </label>
    <label>Descrição
      <textarea name="description" rows="4">{{selectedNode.description}}</textarea>
    </label>

    <div class="constelacao-field-grid">
      <label>Categoria
        <select name="categoryId">
          <option value="">(nenhuma)</option>
          {{#each categories}}
          <option value="{{this.id}}" {{#if (eq this.id ../selectedNode.categoryId)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Raridade
        <select name="rarityId">
          {{#each rarities}}
          <option value="{{this.id}}" {{#if (eq this.id ../selectedNode.rarityId)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Tipo
        <select name="type">
          {{#each nodeTypes}}
          <option value="{{this.value}}" {{#if (eq this.value ../selectedNode.type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Cor própria
        <span class="constelacao-color-row">
          <input type="color" name="color" value="{{selectedNode.colorValue}}">
          {{#if selectedNode.color}}
          <button type="button" data-action="clearNodeColor" data-tooltip="Usar a cor da raridade"><i class="fa-solid fa-eraser"></i></button>
          {{/if}}
        </span>
      </label>
    </div>

    <label>Requisito narrativo
      <input type="text" name="requirements" value="{{selectedNode.requirements}}" placeholder="ex.: sobreviver ao cerco de Umbra">
    </label>

    <label>Observações do Mestre <i class="fa-solid fa-lock constelacao-hint" data-tooltip="O jogador nunca vê"></i>
      <textarea name="gmNotes" rows="3" class="constelacao-gm-notes">{{selectedNode.gmNotes}}</textarea>
    </label>

    <h4 class="constelacao-subtitle">Exclusão mútua</h4>
    <p class="constelacao-placeholder-note">Desbloquear um dos dois fecha o outro para sempre. O jogador não vê esta relação.</p>
    {{#if selectedNode.exclusivePartners.length}}
    <ul class="constelacao-chip-list">
      {{#each selectedNode.exclusivePartners}}
      <li class="constelacao-chip">
        <span>{{this.name}}</span>
        <button type="button" data-action="removeExclusion" data-partner-id="{{this.id}}" data-tooltip="Desfazer exclusão"><i class="fa-solid fa-xmark"></i></button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if selectedNode.exclusionCandidates.length}}
    <select name="add-exclusion">
      <option value="">+ Excluir mutuamente com…</option>
      {{#each selectedNode.exclusionCandidates}}
      <option value="{{this.id}}">{{this.name}}</option>
      {{/each}}
    </select>
    {{/if}}

    <details class="constelacao-details" data-sync="media">
      <summary>Mídia</summary>
      {{#each selectedNode.mediaFields}}
      <label>{{this.label}}
        <span class="constelacao-media-row">
          <input type="text" name="media.{{this.field}}" value="{{this.value}}" placeholder="caminho do arquivo">
          <button type="button" class="constelacao-media-picker" data-action="pickMedia" data-media-field="{{this.field}}" data-media-type="{{this.type}}" data-tooltip="Procurar arquivo"><i class="fa-solid fa-folder-open"></i></button>
        </span>
      </label>
      {{#if (eq this.field "image")}}{{#if this.value}}
      <img class="constelacao-media-preview" src="{{this.value}}" alt="">
      {{/if}}{{/if}}
      {{/each}}
    </details>
  </form>

{{else if selectedConnection}}
  <header class="constelacao-panel-header">
    <p class="constelacao-section-title">Caminho</p>
    <div class="constelacao-panel-header-actions">
      <button type="button" data-action="clearSelection" data-tooltip="Fechar (Esc)"><i class="fa-solid fa-xmark"></i></button>
    </div>
  </header>
  <p class="constelacao-connection">
    <a data-action="selectNode" data-node-id="{{selectedConnection.fromId}}">{{selectedConnection.fromName}}</a>
    <i class="fa-solid fa-arrow-right"></i>
    <a data-action="selectNode" data-node-id="{{selectedConnection.toId}}">{{selectedConnection.toName}}</a>
  </p>
  <p class="constelacao-placeholder-note">Para desbloquear o destino, basta ter desbloqueado uma das origens que chegam até ele.</p>
  <div class="constelacao-button-row">
    <button type="button" data-action="reverseConnection"><i class="fa-solid fa-arrow-right-arrow-left"></i> Inverter sentido</button>
    <button type="button" data-action="removeSelected"><i class="fa-solid fa-trash"></i> Remover</button>
  </div>

{{else}}
  <p class="constelacao-section-title">{{actorName}}</p>
  <p class="constelacao-overview">
    <strong>{{nodeCount}}</strong> Aspecto(s) · <strong>{{unlockedCount}}</strong> desbloqueado(s) · <strong>{{hiddenCount}}</strong> oculto(s) ao jogador
  </p>
  <p class="constelacao-placeholder-note">Clique numa estrela ou num caminho para editar.</p>

  <form data-constellation-form autocomplete="off">
    <details class="constelacao-details" data-sync="settings" open>
      <summary>Fundo e música</summary>
      <label>Imagem de fundo <span class="constelacao-hint">(sem costura, repete pelo canvas)</span>
        <span class="constelacao-media-row">
          <input type="text" name="background" value="{{background}}" placeholder="caminho da imagem">
          <button type="button" class="constelacao-media-picker" data-action="pickMedia" data-scope="constellation" data-media-field="background" data-media-type="image" data-tooltip="Procurar arquivo"><i class="fa-solid fa-folder-open"></i></button>
        </span>
      </label>
      {{#if background}}<img class="constelacao-media-preview" src="{{background}}" alt="">{{/if}}
      <label>Música de fundo <span class="constelacao-hint">(em loop enquanto a janela estiver aberta)</span>
        <span class="constelacao-media-row">
          <input type="text" name="backgroundMusic" value="{{backgroundMusic}}" placeholder="caminho do áudio">
          <button type="button" class="constelacao-media-picker" data-action="pickMedia" data-scope="constellation" data-media-field="backgroundMusic" data-media-type="audio" data-tooltip="Procurar arquivo"><i class="fa-solid fa-folder-open"></i></button>
        </span>
      </label>
    </details>

    <details class="constelacao-details" data-sync="categories">
      <summary>Categorias</summary>
      {{#each categories}}
      <div class="constelacao-list-row">
        <input type="text" name="category-label" value="{{this.label}}" data-category-id="{{this.id}}">
        <input type="color" name="category-color" value="{{#if this.color}}{{this.color}}{{else}}#c9b6e4{{/if}}" data-category-id="{{this.id}}">
        <button type="button" data-action="removeCategory" data-category-id="{{this.id}}" data-tooltip="Remover categoria"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
      <button type="button" data-action="addCategory" class="constelacao-add-button"><i class="fa-solid fa-plus"></i> Nova categoria</button>
    </details>

    <details class="constelacao-details" data-sync="rarities">
      <summary>Raridades</summary>
      {{#each rarities}}
      <div class="constelacao-list-row">
        <input type="text" name="rarity-label" value="{{this.label}}" data-rarity-id="{{this.id}}">
        <input type="color" name="rarity-color" value="{{this.color}}" data-rarity-id="{{this.id}}">
        <input type="number" name="rarity-order" value="{{this.order}}" data-rarity-id="{{this.id}}" data-tooltip="Ordem (mais raro = número maior)">
        <button type="button" data-action="removeRarity" data-rarity-id="{{this.id}}" data-tooltip="Remover raridade"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
      <button type="button" data-action="addRarity" class="constelacao-add-button"><i class="fa-solid fa-plus"></i> Nova raridade</button>
    </details>
  </form>

  <h4 class="constelacao-subtitle">Linha do Tempo da Jornada</h4>
  <button type="button" data-action="logHistoryEntry" class="constelacao-add-button"><i class="fa-solid fa-feather"></i> Registrar momento</button>
  {{#if history.length}}
  <ul class="constelacao-timeline">
    {{#each history}}
    <li>
      <div class="constelacao-timeline-meta">
        <span>{{this.date}}{{#if this.aspect}} — {{this.aspect}}{{/if}}</span>
        <span class="constelacao-timeline-actions">
          <button type="button" data-action="editHistoryEntry" data-index="{{this.index}}" data-tooltip="{{#if this.untitled}}Dar um título de capítulo{{else}}Editar título e data{{/if}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" data-action="removeHistoryEntry" data-index="{{this.index}}" data-tooltip="Apagar entrada"><i class="fa-solid fa-xmark"></i></button>
        </span>
      </div>
      <div class="{{#if this.untitled}}constelacao-timeline-untitled{{/if}}">{{this.title}}</div>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="constelacao-placeholder-note">Nenhum momento registrado ainda.</p>
  {{/if}}
{{/if}}
</div>
