<div class="constelacao-panel-inner">
{{#if selectedNode}}
  <article class="constelacao-aspect" style="--aspect-color: {{selectedNode.rarityColor}}">
    <header class="constelacao-panel-header">
      <div>
        <p class="constelacao-section-title">{{selectedNode.name}}</p>
        {{#if selectedNode.subtitle}}<p class="constelacao-aspect-subtitle">{{selectedNode.subtitle}}</p>{{/if}}
      </div>
      <div class="constelacao-panel-header-actions">
        <button type="button" data-action="clearSelection" data-tooltip="Fechar"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </header>

    {{#if selectedNode.image}}
    <img class="constelacao-aspect-image" src="{{selectedNode.image}}" alt="">
    {{/if}}

    {{#if selectedNode.quote}}
    <blockquote class="constelacao-quote">{{selectedNode.quote}}</blockquote>
    {{/if}}

    {{#if selectedNode.description}}
    <div class="constelacao-description">{{{selectedNode.description}}}</div>
    {{/if}}

    <ul class="constelacao-tags">
      <li class="constelacao-tag constelacao-tag--rarity"><span class="constelacao-swatch"></span>{{selectedNode.rarityLabel}}</li>
      {{#if selectedNode.categoryLabel}}
      <li class="constelacao-tag"{{#if selectedNode.categoryColor}} style="--tag-color: {{selectedNode.categoryColor}}"{{/if}}>{{selectedNode.categoryLabel}}</li>
      {{/if}}
      <li class="constelacao-tag">{{selectedNode.typeLabel}}</li>
    </ul>

    <div class="constelacao-status-box constelacao-status--{{selectedNode.status}}">
      <strong>{{selectedNode.statusLabel}}</strong>
      <p>{{selectedNode.statusNote}}</p>
    </div>
  </article>

{{else}}
  <p class="constelacao-section-title">{{actorName}}</p>

  <div class="constelacao-stats">
    <div><strong>{{unlockedCount}}</strong><span>desbloqueado(s)</span></div>
    <div><strong>{{nodeCount}}</strong><span>no céu visível</span></div>
    <div class="constelacao-stats-points"><strong>{{unspentPoints}}</strong><span>Ponto(s) da Apoteose</span></div>
  </div>

  {{#if available.length}}
  <h4 class="constelacao-subtitle">Ao seu alcance</h4>
  <ul class="constelacao-link-list">
    {{#each available}}
    <li><a data-action="selectNode" data-node-id="{{this.id}}"><i class="fa-regular fa-star"></i> {{this.name}}</a></li>
    {{/each}}
  </ul>
  {{#if unspentPoints}}
  <p class="constelacao-placeholder-note">Escolha onde investir seu Ponto e diga ao Mestre: é ele quem marca o desbloqueio.</p>
  {{/if}}
  {{/if}}

  <p class="constelacao-placeholder-note">Clique numa estrela para ler o Aspecto.</p>

  {{#if history.length}}
  <h4 class="constelacao-subtitle">Linha do Tempo da Jornada</h4>
  <ul class="constelacao-timeline">
    {{#each history}}
    <li>
      <div class="constelacao-timeline-meta"><span>{{this.date}}{{#if this.aspect}} — {{this.aspect}}{{/if}}</span></div>
      <div class="{{#if this.untitled}}constelacao-timeline-untitled{{/if}}">{{this.title}}</div>
    </li>
    {{/each}}
  </ul>
  {{/if}}
{{/if}}
</div>
